# Copy this file to .env.local and fill in real values.
# .env / .env.local / .env* are already gitignored — never commit real secrets.

# --- Client-side (VITE_ prefix = bundled into the browser, non-secret only) ---
VITE_CARTO_API_KEY=

# Supabase project (Settings -> API in the Supabase dashboard). The anon key
# is meant to be public — Supabase's security model is Row Level Security
# (see supabase/schema.sql), not keeping this key secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (Vercel serverless functions under /api) ---
# NEVER prefix these with VITE_ — that would ship them to the browser.

# Google AI Studio API key. Used by api/ai/chat.js (the AiChat assistant)
# and api/ai/intent.js (AI-assisted destination search on Home's "Where to?"
# field) — both run server-side only. This replaces the old
# VITE_GEMINI_API_KEY, which shipped the key to every client's browser.
GEMINI_API_KEY=

# Obtained from Grab's partner portal after partner approval.
GRAB_CLIENT_ID=
GRAB_CLIENT_SECRET=

# Grab's OAuth token endpoint — only published in Grab's partner docs.
# Fill this in from those docs; nothing here is guessed.
GRAB_OAUTH_TOKEN_URL=

# "staging" or "production" — selects the default Farefeed base URL below.
# Override directly with GRAB_API_BASE_URL if you need to.
GRAB_ENVIRONMENT=staging
# GRAB_API_BASE_URL=https://partner-api.stg-myteksi.com
